# MASEST commerce — environment (Phase 1)
# Copy to .env (local) and set the same vars in Vercel Project Settings → Environment Variables.
# NEVER commit .env. Service-role key is server-only — never ship it to the browser.

# --- Supabase (Phase 1) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...            # safe for browser (RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SERVER ONLY. bypasses RLS. never expose.

# Public app origin (for redirects/emails)
APP_URL=https://masest.co

# --- Stripe (Phase 2 — placeholders) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TAX_ENABLED=                            # set to the string "true" to enable Stripe Tax on checkout (binds B2B sessions to the company Customer + honors tax_exempt). Anything else = off.
STRIPE_SHIPPING_RATE_IDS=                      # fallback for paid checkout until published CMS Shipping rates exist. Comma-separated active Stripe Shipping Rate IDs (shr_...). Missing/invalid effective config fails closed before creating a Checkout Session.
# Secret for POST /api/admin/stripe-effects (x-stripe-effects-secret). Scheduler is an
# operator-owned production step and is intentionally not provisioned by this repo change.
STRIPE_EFFECTS_WORKER_SECRET=

# --- Resend transactional email (order confirmation, sent from stripe-webhook) ---
RESEND_API_KEY=
RESEND_FROM=MASEST <noreply@masest.co>   # MUST be a Resend-VERIFIED domain (masest.co is verified), else 422. Used for ORDER/OFFER/QUOTE emails — signup-confirm email is sent by Supabase Auth SMTP, configured separately in the Supabase dashboard.
ORDER_NOTIFY_EMAIL=                            # optional: BCC internal sales on every order
RESEND_WEBHOOK_SECRET=                         # Svix secret from Resend Dashboard -> Webhooks (whsec_...). Verifies /api/resend-webhook. Without it the webhook no-ops (200). Subscribe these events: email.sent, email.delivered, email.bounced, email.complained, email.failed, email.delivery_delayed, email.received.
RESEND_REPLY_TO=                               # optional: default Reply-To so replies reach a human (e.g. matthew@masest.co). Per-send replyTo overrides it.
RESEND_INBOUND_DOMAIN=                         # Resend-managed receiving domain for direct customer replies, e.g. your-id.resend.app. Do NOT point this at masest.co's Outlook/GoDaddy MX domain.
MESSAGE_REPLY_SECRET=                          # random secret signing per-company Reply-To addresses; required with RESEND_INBOUND_DOMAIN.
EMAIL_UNSUB_SECRET=                            # optional: HMAC secret enabling one-click List-Unsubscribe on marketing emails (/api/email/unsubscribe). Unset = header omitted (no breakage); marketing suppression still works via the webhook.

# --- Durable newsletter delivery (operator-owned cron + migration) ---
NEWSLETTER_CRON_SECRET=                        # shared by Cloudflare Pages and newsletter-cron scheduler
BLOG_NEWSLETTER_SECRET=                       # shared by Cloudflare Pages and publish-blog scheduler
NEWSLETTER_DELIVERY_CONCURRENCY=5              # initial bounded worker concurrency; implementation hard-caps at 5
NEWSLETTER_DELIVERY_BATCH_SIZE=25              # claim size per cron invocation; implementation hard-caps at 500
NEWSLETTER_DELIVERY_LEASE_SECONDS=300          # processing lease; expired rows are safely reclaimed with same idempotency key

# --- Contact / quote intake (/api/quote — replaces Formspree) ---
SALES_EMAIL=matthew@masest.co                  # where new quote/contact leads are emailed (comma-sep ok). Lead-notify fallback chain: SALES_EMAIL → ORDER_NOTIFY_EMAIL → CONTACT_EMAIL → ADMIN_EMAILS → ADMIN_EMAIL → matthew@masest.co.
CONTACT_EMAIL=                                  # optional: another fallback recipient for lead emails (see chain above).
ADMIN_EMAIL=                                    # optional: last-resort single fallback recipient (note: ADMIN_EMAILS, plural, is the staff gate below).
SITE_URL=https://masest.co                      # optional: CTA/link base in lead emails. Falls back to https://masest.co.
# Apply supabase/schema-quotes.sql once so leads also persist + show in the admin Quotes tab.
# TURNSTILE_SECRET (optional) — if set, /api/quote verifies a cf-turnstile-response when the
# contact form sends one. Soft gate: a missing token never blocks a legitimate submission.
TURNSTILE_SECRET=
MASEST_TURNSTILE_SECRET=                        # optional alias for TURNSTILE_SECRET (TURNSTILE_SECRET wins if both set).
# Quote→CRM sweep cron (supabase/quote-sweep-cron.example.sql). Shared secret the scheduled job
# sends as x-quote-crm-secret to POST /api/admin/quotes {action:'sweep_due'}. Unset = endpoint rejects.
QUOTE_CRM_SECRET=

# --- Klaviyo marketing email (Phase 4) ---
KLAVIYO_PRIVATE_KEY=pk_...          # SERVER ONLY (newsletter function). never client-side.
KLAVIYO_LIST_ID=                    # the newsletter list ID to subscribe into
# Per-industry nurture lists — each maps to a Klaviyo list with a list-triggered 3-email flow.
# Quote leads are subscribed to the list matching their industry; unmapped/empty -> KLAVIYO_LIST_NURTURE.
KLAVIYO_LIST_OIL_GAS=
KLAVIYO_LIST_MARINE=
KLAVIYO_LIST_MANUFACTURING=
KLAVIYO_LIST_FOOD_BEVERAGE=
KLAVIYO_LIST_HEALTHCARE=
KLAVIYO_LIST_CONSTRUCTION=
KLAVIYO_LIST_MILITARY_GOV=
KLAVIYO_LIST_EDUCATION=
KLAVIYO_LIST_HVAC_WATER=
KLAVIYO_LIST_PLUMBING=
KLAVIYO_LIST_NURTURE=               # fallback list for Other / unspecified industry

# --- QuickBooks Online / Intuit ---
# Optional single-secret bundle. Accepts JSON, base64 JSON, or KEY=value lines
# containing: client_id, client_secret, redirect_uri, oauth_state_secret,
# sync_secret, environment, and optionally realm_id and income_account_id.
QBO_CONNECT_KEY=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=https://masest.co/api/admin/qbo/callback
QBO_OAUTH_STATE_SECRET=
QBO_SYNC_SECRET=
QBO_INCOME_ACCOUNT_ID=              # optional; sync auto-detects an Income account when omitted
# QuickBooks Payments must be enabled in the connected QBO company for generated NET invoices to show online card/ACH payment options.

# --- Phase 5 dashboards (user + admin) ---
# AUTHORITATIVE staff/admin gate for /api/admin/* and admin.html. Comma-separated, case-insensitive.
# Any signed-in Supabase user whose email is in this list is treated as MASEST staff.
ADMIN_EMAILS=aoaljamal@gmail.com
# RESEND_API_KEY (above) also powers the admin "offer email" blast. Without it, offers are in-app only.

# --- Admin CMS ---
CONTENT_PUBLISH_HOOK_URL=                 # Cloudflare Pages Deploy Hook URL triggered after CMS Publish.
CF_PAGES_DEPLOY_HOOK_URL=                 # optional alias/fallback for the deploy hook if CONTENT_PUBLISH_HOOK_URL is unset.
CONTENT_ASSET_BUCKET=content-assets       # Supabase Storage bucket used by /api/admin/content-assets uploads.

# --- Programs (Stripe subscriptions) ---
# JSON map of program tier -> Stripe recurring price id. Create the prices in Stripe, then set this.
# Empty/unset = the business hub falls back to the request-enrollment message flow.
PROGRAM_PRICES=   # e.g. {"Bronze":"price_...","Silver":"price_...","Gold":"price_...","Platinum":"price_..."}
