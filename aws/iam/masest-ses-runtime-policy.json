{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendMarketingFromDedicatedIdentity",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:us-east-1:791359098991:identity/marketing.masest.co",
        "arn:aws:ses:us-east-1:791359098991:identity/masest.co",
        "arn:aws:ses:us-east-1:791359098991:configuration-set/masest-marketing",
        "arn:aws:ses:us-east-1:791359098991:contact-list/masest-marketing"
      ],
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "news@marketing.masest.co"
        }
      }
    },
    {
      "Sid": "SyncCanonicalMarketingConsent",
      "Effect": "Allow",
      "Action": [
        "ses:CreateContact",
        "ses:UpdateContact"
      ],
      "Resource": "arn:aws:ses:us-east-1:791359098991:contact-list/masest-marketing"
    },
    {
      "Sid": "ReadAccountSuppressionList",
      "Effect": "Allow",
      "Action": "ses:ListSuppressedDestinations",
      "Resource": "*"
    }
  ]
}
